ENV=dev
DATABASE_URL=sqlite:///./agentbank.db
# DATABASE_URL=postgresql+psycopg://agentbank:agentbank@localhost:5432/agentbank
PUBLIC_BASE_URL=http://localhost:8000

# PayPal sandbox app credentials. Leave empty => built-in MOCK mode (demo-safe, no network).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Gemini key. Leave empty => deterministic heuristic fallbacks (everything still runs).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CURRENCY=USD
APPROVAL_THRESHOLD_CENTS=5000
PER_TX_LIMIT_CENTS=100000
DAILY_LIMIT_CENTS=250000
DEMO_DELAY_SECONDS=0.8
